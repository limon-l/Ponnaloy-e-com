# ============================================================
# Ponnaloy environment variables (example only)
# Copy to .env (root), apps/api/.env and apps/web/.env as needed.
# Never commit real secrets. This file contains no credentials.
# ============================================================

# ------------------------------------------------------------
# Application ports
# The web app uses 3000. The API defaults to 3001, so do not set
# PORT=3000 in apps/api/.env or the two processes will collide.
# ------------------------------------------------------------
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------
# MongoDB
# Prisma's MongoDB connector requires a replica set (transactions).
# The bundled docker-compose.yml starts a single-node replica set.
# Atlas connection strings already provide a replica set.
# ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ponnaloy?replicaSet=rs0

# ------------------------------------------------------------
# Authentication
# Required in production. Use at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Legacy Express session secret (only used by the frozen legacy stack).
SESSION_SECRET=replace-with-a-random-secret

# ------------------------------------------------------------
# Redis (optional; set REDIS_ENABLED=false to disable caching)
# When Redis is unavailable the API falls back to an in-process cache.
# Set MEMORY_CACHE=false to disable that fallback (for example in tests).
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
MEMORY_CACHE=true

# ------------------------------------------------------------
# Meilisearch (optional; database filtering is used when absent)
# ------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=ponnaloy_master_key

# ------------------------------------------------------------
# Local uploads (default: ./uploads, served at /uploads/*)
# Replace with an object-storage driver for durable multi-instance media.
# ------------------------------------------------------------
UPLOAD_DIR=uploads

# ------------------------------------------------------------
# Stripe (optional; enables card payments only when BOTH server keys exist)
# Without STRIPE_WEBHOOK_SECRET the API refuses to offer card payments,
# because payment success could never be verified.
# ------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# Email delivery (password reset, transactional mail)
# When SMTP_HOST is unset, messages are serialised in-process and are
# NEVER reported as delivered. Configure a provider for real delivery.
# ------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Ponnaloy <no-reply@example.com>"

# ------------------------------------------------------------
# Clerk (optional identity provider / webhook verification)
# ------------------------------------------------------------
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# OpenAI shopping assistant (optional)
# ------------------------------------------------------------
# OPENAI_API_KEY=

# ------------------------------------------------------------
# Cloudflare R2 / S3 (optional; storage adapter not wired yet)
# ------------------------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ponnaloy
# R2_PUBLIC_URL=

# ------------------------------------------------------------
# Deployment
# Opt-in wildcard for *.vercel.app preview origins (keep false in production).
# ------------------------------------------------------------
ALLOW_VERCEL_PREVIEWS=false
