generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ─── Users & Auth ────────────────────────────────────────────

model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  clerkId           String?
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  phone             String?
  avatar            String?
  role              Role      @default(CUSTOMER)
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  lastLoginAt       DateTime?
  // Set whenever credentials change so previously issued JWTs can be rejected.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders                     Order[]
  reviews                    Review[]
  wishlist                   Wishlist[]
  addresses                  Address[]
  cart                       Cart?
  notifications              Notification[]
  activityLogs               ActivityLog[]
  passwordResetTokens        PasswordResetToken[]
  sellerMemberships          SellerMembership[]
  sellerApplications         SellerApplication[]  @relation("SellerApplicant")
  reviewedSellerApplications SellerApplication[]  @relation("SellerApplicationReviewer")
  ownedSellers               SellerOrganization[] @relation("SellerOwner")

  // Clerk is optional. A plain unique index on a nullable field rejects every
  // local user after the first one in MongoDB, so uniqueness is enforced in
  // application code and this index only speeds up lookups.
  @@index([clerkId])
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  // Only the SHA-256 hash is stored; the raw token exists solely in the email.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

// ─── Products ────────────────────────────────────────────────

model Product {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String            @unique
  description      String?
  shortDescription String?
  sku              String?           @unique
  price            Int
  compareAtPrice   Int?
  costPrice        Int?
  barcode          String?
  status           ProductStatus     @default(DRAFT)
  isFeatured       Boolean           @default(false)
  isTrending       Boolean           @default(false)
  isNewArrival     Boolean           @default(false)
  weight           Float?
  weightUnit       String?           @default("g")
  metaTitle        String?
  metaDescription  String?
  avgRating        Float             @default(0)
  reviewCount      Int               @default(0)
  totalSold        Int               @default(0)
  // Product-level inventory used when the product has no variants.
  stock            Int               @default(0)
  // Seller-owned products carry a sellerId. Platform-owned catalog rows keep
  // this null, so existing data remains valid.
  sellerId         String?           @db.ObjectId
  moderationStatus ModerationStatus?
  moderationNote   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  seller     SellerOrganization? @relation(fields: [sellerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  category   Category?           @relation(fields: [categoryId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  categoryId String?             @db.ObjectId
  brand      Brand?              @relation(fields: [brandId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  brandId    String?             @db.ObjectId

  images          ProductImage[]
  variants        ProductVariant[]
  specifications  ProductSpec[]
  reviews         Review[]
  wishlist        Wishlist[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  collections     ProductCollection[]
  relatedProducts ProductRelation[]   @relation("source")
  relatedTo       ProductRelation[]   @relation("target")
  searchDocuments SearchDocument?

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([sellerId])
  @@index([moderationStatus])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([price])
  @@index([createdAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  alt       String?
  position  Int     @default(0)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([productId])
}

model ProductVariant {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  sku       String?    @unique
  price     Int
  stock     Int        @default(0)
  image     String?
  options   Json
  productId String     @db.ObjectId
  product   Product    @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  cartItems CartItem[]

  @@index([productId])
}

model ProductSpec {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  value     String
  position  Int     @default(0)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([productId])
}

model ProductRelation {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  sourceId String  @db.ObjectId
  targetId String  @db.ObjectId
  type     String  @default("related")
  source   Product @relation("source", fields: [sourceId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  target   Product @relation("target", fields: [targetId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

// ─── Categories & Brands ─────────────────────────────────────

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?    @db.ObjectId
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  logo        String?
  description String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

// ─── Collections ─────────────────────────────────────────────

model Collection {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  position    Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products ProductCollection[]
}

model ProductCollection {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  productId    String     @db.ObjectId
  collectionId String     @db.ObjectId
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  collection   Collection @relation(fields: [collectionId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([productId, collectionId])
  @@index([collectionId])
}

// ─── Orders ──────────────────────────────────────────────────

model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)
  subtotal       Int
  shippingFee    Int         @default(0)
  tax            Int         @default(0)
  discount       Int         @default(0)
  total          Int
  currency       String      @default("USD")
  notes          String?
  // Client-supplied key that makes order creation safe to retry. Uniqueness is
  // enforced through IdempotencyRecord (a required primary key), because a
  // unique index on an optional MongoDB field has unreliable null semantics.
  idempotencyKey String?
  // Set when inventory has been returned to stock, so cancellations and
  // returns can never restock the same order twice.
  restockedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  shippingAddress Json
  billingAddress  Json?

  items         OrderItem[]
  payments      Payment[]
  shipments     Shipment[]
  statusHistory OrderStatusLog[]
  returnRequest ReturnRequest?
  sellerOrders  SellerOrder[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  quantity      Int
  unitPrice     Int
  total         Int
  productId     String       @db.ObjectId
  variantId     String?      @db.ObjectId
  orderId       String       @db.ObjectId
  sellerOrderId String?      @db.ObjectId
  product       Product      @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  order         Order        @relation(fields: [orderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([orderId])
  @@index([productId])
  @@index([sellerOrderId])
}

model OrderStatusLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  status    OrderStatus
  note      String?
  // Who caused the transition. Optional because historical rows predate it.
  actorId   String?     @db.ObjectId
  actorRole String?
  createdAt DateTime    @default(now())
  orderId   String      @db.ObjectId
  order     Order       @relation(fields: [orderId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([orderId])
}

// ─── Payments ────────────────────────────────────────────────

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  amount          Int
  currency        String        @default("USD")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionId   String?
  stripeSessionId String?
  paypalOrderId   String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([orderId])
  @@index([transactionId])
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  SSLCOMMERZ
  RAZORPAY
  COD
  BANK_TRANSFER
}

// Immutable record of every verified gateway event. The unique `eventId` makes
// webhook processing idempotent: a retried or out-of-order delivery can never
// apply the same financial effect twice.
model PaymentEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @unique
  type        String
  provider    String   @default("stripe")
  orderId     String?  @db.ObjectId
  paymentId   String?  @db.ObjectId
  payload     Json?
  processedAt DateTime @default(now())

  @@index([type])
  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

// ─── Shipping ────────────────────────────────────────────────

model Shipment {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  carrier           String?
  trackingNumber    String?
  method            String?
  status            String    @default("pending")
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orderId       String       @db.ObjectId
  sellerOrderId String?      @db.ObjectId
  order         Order        @relation(fields: [orderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([orderId])
  @@index([sellerOrderId])
}

// ─── Returns ──────────────────────────────────────────────

model ReturnRequest {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  reason    String
  status    ReturnStatus @default(PENDING)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orderId String @unique @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ─── Reviews ─────────────────────────────────────────────────

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  rating     Int
  title      String?
  comment    String?
  images     String[]
  isVerified Boolean  @default(false)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId    String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  productId String       @db.ObjectId
  product   Product      @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  votes     ReviewVote[]

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model ReviewVote {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  helpful  Int    @default(0)
  userId   String @db.ObjectId
  reviewId String @db.ObjectId
  review   Review @relation(fields: [reviewId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([userId, reviewId])
}

// ─── Wishlist ────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Cart ────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String      @unique @db.ObjectId
  user   User        @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  items  CartItem[]
  coupon CartCoupon?
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId    String          @db.ObjectId
  cart      Cart            @relation(fields: [cartId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  productId String          @db.ObjectId
  product   Product         @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  variantId String?         @db.ObjectId
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model CartCoupon {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  code     String
  discount Int
  cartId   String @unique @db.ObjectId
  cart     Cart   @relation(fields: [cartId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

// ─── Addresses ───────────────────────────────────────────────

model Address {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  label        String   @default("Home")
  fullName     String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zipCode      String
  country      String   @default("US")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([userId])
}

// ─── Coupons ─────────────────────────────────────────────────

model Coupon {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  code              String       @unique
  description       String?
  discountType      DiscountType
  discountValue     Int
  minOrderAmount    Int?
  maxDiscountAmount Int?
  usageLimit        Int?
  usedCount         Int          @default(0)
  perUserLimit      Int?
  isActive          Boolean      @default(true)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([isActive])
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ─── Idempotency ─────────────────────────────────────────────

model IdempotencyRecord {
  id        String   @id @map("_id")
  scope     String   @default("order")
  userId    String
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Newsletter ──────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([userId])
  @@index([isRead])
}

enum NotificationType {
  ORDER
  PAYMENT
  SHIPPING
  REFUND
  PROMOTION
  SYSTEM
}

// ─── Banners ─────────────────────────────────────────────────

model Banner {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  subtitle      String?
  image         String
  link          String?
  position      BannerPosition @default(HERO)
  isActive      Boolean        @default(true)
  positionOrder Int            @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([position])
  @@index([isActive])
}

enum BannerPosition {
  HERO
  SIDEBAR
  PROMO
}

// ─── Activity Logs ───────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ─── Search ──────────────────────────────────────────────────

model SearchDocument {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  entityId  String
  title     String
  body      String?
  image     String?
  url       String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String?  @unique @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([type])
  @@index([entityId])
}

// ─── Settings ────────────────────────────────────────────────

model StoreSetting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value Json
  group String @default("general")

  @@index([group])
}

// ── Marketplace: sellers, memberships, applications ─────────────────────────

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum SellerApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model SellerOrganization {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String       @unique
  description     String?
  logo            String?
  banner          String?
  status          SellerStatus @default(PENDING)
  commissionRate  Int          @default(1000) // basis points; 1000 = 10%
  supportEmail    String?
  supportPhone    String?
  businessAddress Json?
  policies        Json?
  approvedAt      DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  ownerId String @db.ObjectId
  owner   User   @relation("SellerOwner", fields: [ownerId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  memberships  SellerMembership[]
  applications SellerApplication[]
  products     Product[]
  sellerOrders SellerOrder[]

  @@index([status])
  @@index([ownerId])
}

model SellerMembership {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  role      SellerMemberRole @default(OWNER)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  sellerId String             @db.ObjectId
  userId   String             @db.ObjectId
  seller   SellerOrganization @relation(fields: [sellerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  user     User               @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([sellerId, userId])
  @@index([userId])
}

model SellerApplication {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  businessName       String
  businessType       String?
  registrationNumber String?
  taxId              String?
  contactEmail       String
  contactPhone       String?
  address            Json
  description        String?
  status             SellerApplicationStatus @default(SUBMITTED)
  reviewNote         String?
  submittedAt        DateTime                @default(now())
  reviewedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  userId       String  @db.ObjectId
  sellerId     String? @db.ObjectId
  reviewedById String? @db.ObjectId

  user       User                @relation("SellerApplicant", fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  reviewedBy User?               @relation("SellerApplicationReviewer", fields: [reviewedById], references: [id], onUpdate: NoAction, onDelete: NoAction)
  seller     SellerOrganization? @relation(fields: [sellerId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([status])
  @@index([userId])
  @@index([sellerId])
}

// ── Marketplace: seller-scoped order partitions ─────────────────────────────

model SellerOrder {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  status           OrderStatus @default(PENDING)
  subtotal         Int
  shippingFee      Int         @default(0)
  discount         Int         @default(0)
  total            Int
  commissionAmount Int         @default(0)
  restockedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  orderId  String             @db.ObjectId
  sellerId String             @db.ObjectId
  order    Order              @relation(fields: [orderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  seller   SellerOrganization @relation(fields: [sellerId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  items         OrderItem[]
  statusHistory SellerOrderStatusLog[]
  shipments     Shipment[]

  @@unique([orderId, sellerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

model SellerOrderStatusLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  status    OrderStatus
  note      String?
  actorId   String?     @db.ObjectId
  actorRole String?
  createdAt DateTime    @default(now())

  sellerOrderId String      @db.ObjectId
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([sellerOrderId])
}
