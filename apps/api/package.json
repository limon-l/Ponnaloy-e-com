{
  "name": "@ponnaloy/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && echo 'Build complete'",
    "start": "tsx src/server.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@clerk/fastify": "^3.1.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/redis": "^6.2.0",
    "@fastify/session": "^11.0.1",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@ponnaloy/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "meilisearch": "^0.44.1",
    "nanoid": "^5.0.9",
    "nodemailer": "^10.2.1",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "prom-client": "^15.1.0",
    "stripe": "^17.4.0",
    "svix": "^1.99.1",
    "tsx": "^4.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.15.0",
    "mongodb-memory-server": "^11.3.0",
    "smtp-server": "^3.21.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
