{
  "name": "ponnaloy-e-com",
  "version": "2.0.0",
  "private": true,
  "description": "Premium multi-vendor e-commerce platform",
  "scripts": {
    "dev": "turbo dev --filter=@ponnaloy/web --filter=@ponnaloy/api",
    "dev:web": "pnpm --filter @ponnaloy/web dev",
    "dev:api": "pnpm --filter @ponnaloy/api dev",
    "build": "turbo build --filter=@ponnaloy/web --filter=@ponnaloy/api",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @ponnaloy/api test",
    "db:generate": "pnpm --filter @ponnaloy/api db:generate",
    "db:push": "pnpm --filter @ponnaloy/api db:push",
    "db:migrate": "pnpm --filter @ponnaloy/api db:migrate",
    "db:seed": "pnpm --filter @ponnaloy/api db:seed",
    "db:seed:accounts": "pnpm --filter @ponnaloy/api seed:accounts",
    "db:seed:seller": "pnpm --filter @ponnaloy/api seed:seller",
    "db:studio": "pnpm --filter @ponnaloy/api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy": "3.2.4",
      "brace-expansion@>=4.0.0": "5.0.12",
      "deepmerge-ts": "8.0.2",
      "fast-copy": "4.3.1",
      "fast-uri@<4.0.0": "3.1.9",
      "fast-uri@>=4.0.0": "4.2.3",
      "postcss": "8.5.32",
      "postcss-selector-parser": "6.1.5",
      "qs": "6.17.1",
      "sharp": "0.35.5"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
